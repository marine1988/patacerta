server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # DNS resolver interno do Docker (127.0.0.11). Necessario para que o
    # nginx re-resolva o hostname `api` (e `minio`) periodicamente em
    # vez de cachear o IP descoberto no boot. Sem isto, qualquer
    # redeploy da API muda o IP do contentor mas o nginx continua a
    # tentar o IP velho => 502 "Host is unreachable" sustained ate
    # alguem reiniciar o contentor web manualmente. Ver issue tipico:
    # https://stackoverflow.com/q/35744650
    #
    # `valid=10s` faz o nginx voltar a resolver de 10 em 10s.
    # `ipv6=off` evita warnings ipv6 no docker network.
    resolver 127.0.0.11 valid=10s ipv6=off;

    # SEO: header configuravel por ambiente. Em producao fica vazio (linha
    # vira no-op). Em ambientes nao-publicos (stage, preview) e' definido
    # como `add_header X-Robots-Tag "noindex, nofollow" always;` via
    # variavel `ROBOTS_HEADER` no docker-compose / Dokploy.
    #
    # Substituicao via envsubst no entrypoint da imagem nginx oficial
    # (template em /etc/nginx/templates/default.conf.template). A
    # `NGINX_ENVSUBST_FILTER` esta definida no Dockerfile para limitar
    # as variaveis substituidas e nao quebrar `$host`, `$remote_addr`, etc.
    ${ROBOTS_HEADER}

    # ── Headers de seguranca do conteudo servido pelo proprio nginx ──────
    #
    # A API (Express + helmet) ja' envia o conjunto completo em /api/*.
    # O que o nginx serve localmente — HTML do SPA, manifest, robots.txt /
    # llms.txt, assets do build, uploads do MinIO — nao tinha um unico
    # header de seguranca (card PATA-BUG-4). Sem
    # `X-Frame-Options`/`frame-ancestors`, qualquer site podia embeber
    # patacerta.pt num iframe e sobrepor os botoes de login/publicacao
    # (clickjacking); sem `nosniff` o browser decide sozinho o tipo do
    # ficheiro.
    #
    # ARMADILHA (ler antes de mexer): em nginx um `add_header` dentro de um
    # bloco `location` SUBSTITUI todos os `add_header` herdados do `server`
    # — nao ha' merge. Por isso este conjunto, e o `${ROBOTS_HEADER}` acima,
    # tem de ser repetido em CADA location que sirva conteudo proprio e que
    # declare os seus proprios headers:
    #
    #   - `location /`                     (SPA + HTML)
    #   - `= /manifest.webmanifest`
    #   - `~* \.(js|css|png|...)`          (assets; ja' tinha Cache-Control)
    #   - `^~ /patacerta-uploads/`         (MinIO; ja' tinha Cache-Control)
    #
    # Esquecer a repeticao num location novo => esse conteudo volta a ser
    # embutivel; em stage volta a ser indexavel (o `X-Robots-Tag` do
    # `${ROBOTS_HEADER}` tambem e' substituido, nunca herdado). O teste
    # `apps/web/src/nginx-security-headers.test.ts` falha se aparecer um
    # location de conteudo sem isto.
    #
    # Os locations que fazem proxy para a API (`/api/`, `= /sitemap.xml`,
    # `^/criador/:id`, `^/servicos/:id`) ficam de fora de proposito: quem
    # responde e' a API com os headers dela, e repetir aqui o
    # `Referrer-Policy`/`Permissions-Policy` punha dois valores
    # contraditorios na mesma resposta (helmet manda `no-referrer`; aqui
    # seria `strict-origin-when-cross-origin`).
    #
    # Nao inclui `Strict-Transport-Security`: o contentor so' fala HTTP e um
    # max-age fixo no browser e' caro de reverter (a API ja' o envia em
    # /api/*). Isso e' decisao do terminador TLS (Traefik/Dokploy).
    #
    # A CSP vai em `Report-Only` de proposito: em modo enforcing parte
    # AdSense/Stripe. Promover para enforcing exige antes observar o
    # relatorio sem violacoes inesperadas.
    # ─────────────────────────────────────────────────────────────────────

    # Proxy API requests to the backend service.
    # IMPORTANTE: usar variavel `$api_upstream` (em vez de literal
    # `http://api:3001`) forca o nginx a re-resolver o hostname a cada
    # request via `resolver` definido acima — evita IP cacheado quando
    # o contentor API reaparece com novo IP apos redeploy.
    location /api/ {
        set $api_upstream http://api:3001;
        proxy_pass $api_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # File uploads — allow up to 10MB
        client_max_body_size 10m;
    }

    # SEO: sitemap dinâmico servido pelo API. Tem que estar na raiz
    # (motores procuram /sitemap.xml), não dentro de /api/. O API
    # define Cache-Control: public, max-age=3600 — não duplicar aqui.
    location = /sitemap.xml {
        set $api_upstream http://api:3001;
        proxy_pass $api_upstream/sitemap.xml;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # SEO: redirect 301 /criador/:id (numérico) -> /criador/:slug.
    # Usa um proxy interno para o API que devolve 301 com Location
    # absoluta (PUBLIC_URL). Só intercepta IDs puramente numéricos —
    # slugs (que têm letras/hífens) caem no SPA fallback abaixo.
    #
    # Quando o ID não existe (404 do API), interceptamos o erro e
    # delegamos para o SPA — assim a página /criador/:id renderiza
    # o estado "Criador não encontrado" em vez de servir HTML 404
    # do nginx (que rebenta toda a navegação client-side).
    location ~ ^/criador/(\d+)$ {
        set $api_upstream http://api:3001;
        proxy_pass $api_upstream/__redirect/breeder/$1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Deixar 301 (Location) passar para o cliente.
        proxy_redirect off;
        # Mas interceptar 404 (ID inexistente) e cair no SPA.
        proxy_intercept_errors on;
        error_page 404 = @spa_fallback;
    }

    location ~ ^/servicos/(\d+)$ {
        set $api_upstream http://api:3001;
        proxy_pass $api_upstream/__redirect/service/$1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_redirect off;
        proxy_intercept_errors on;
        error_page 404 = @spa_fallback;
    }

    # Named location usado pelos blocos /criador/:id e /servicos/:id
    # para fallback ao SPA quando o API devolve 404 (ID inexistente).
    location @spa_fallback {
        rewrite ^ /index.html last;
    }

    # Proxy MinIO public objects (breeder photos, service photos, etc.).
    # The API stores URLs like /patacerta-uploads/<key>; this block
    # serves them by proxying to the MinIO container. Bucket has a
    # public-read policy applied on API boot (see apps/api/src/lib/minio.ts).
    #
    # IMPORTANT: ^~ takes precedence over the regex location for static
    # file extensions (.jpg/.png/...) further down. Without it, photo
    # URLs would fall through to the static-asset cache rule and hit a
    # local 404 instead of being proxied to MinIO.
    location ^~ /patacerta-uploads/ {
        set $minio_upstream http://minio:9000;
        proxy_pass $minio_upstream;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Allow large object responses
        proxy_buffering off;
        proxy_request_buffering off;

        # Cache aggressively in browsers — object names contain UUIDs,
        # so the URL changes whenever the file changes.
        expires 1y;
        add_header Cache-Control "public, immutable";

        # Seguranca: repetido do `server` — esta location ja' define os seus
        # `add_header`, logo nao herda nenhum (ver bloco no topo do ficheiro).
        # Aqui importa mais do que nas imagens do build: o conteudo e'
        # carregado por utilizadores (fotos, PDFs), servido da MESMA origem
        # do site. Um ficheiro que o browser trate como documento (SVG, PDF)
        # sem `nosniff` nem `frame-ancestors` e' um vector de XSS/clickjacking
        # armazenado.
        ${ROBOTS_HEADER}
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; frame-ancestors 'self'" always;
    }

    # SPA routing - fallback to index.html
    location / {
        try_files $uri $uri/ /index.html;

        # Seguranca: repetido do `server` (add_header de location substitui
        # os herdados — ver bloco "Headers de seguranca" no topo).
        ${ROBOTS_HEADER}
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; frame-ancestors 'self'" always;
    }

    # SEO/PWA: forçar Content-Type correcto para o manifest. O mime.types
    # default do nginx mapeia .webmanifest para application/octet-stream,
    # o que faz o Lighthouse marcar o PWA como inválido.
    location = /manifest.webmanifest {
        default_type application/manifest+json;

        # Seguranca: repetido do `server` (ver bloco no topo do ficheiro).
        ${ROBOTS_HEADER}
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; frame-ancestors 'self'" always;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";

        # Seguranca: repetido do `server` — esta location ja' define os seus
        # `add_header`, logo nao herda nenhum (ver bloco no topo do ficheiro).
        # `nosniff` conta a dobrar aqui: `og-image.svg` e' servido deste
        # caminho e um SVG e' um documento (executa script) se o browser o
        # tratar como tal.
        ${ROBOTS_HEADER}
        add_header X-Content-Type-Options "nosniff" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(self), camera=(), microphone=()" always;
        add_header Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; frame-ancestors 'self'" always;
    }

    # Gzip
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript image/svg+xml;
}
